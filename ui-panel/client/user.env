# Configuration File
DANGEROUSLY_DISABLE_HOST_CHECK=true
HOST=0.0.0.0
# Port is configured in config/auth.json

# CloudFormation Template Paths (relative to project root directory)
CF_TEMPLATE_PATH=cli-min/1-eks-full-stack.yaml
HYPERPOD_TEMPLATE_PATH=cli-min/2-hypd-compute-c1.yaml

# Refresh Mechanism Configuration
# Set to true to disable old GlobalRefreshManager and use new resourceEventBus
REACT_APP_DISABLE_GLOBAL_REFRESH=true

# Application Version
REACT_APP_VERSION=main

# UI Zoom (body-level scale). Affects layout via CSS var --zoom-factor.
# Component calc() expressions divide by var(--zoom-factor) to stay viewport-correct.
REACT_APP_UI_ZOOM=0.8