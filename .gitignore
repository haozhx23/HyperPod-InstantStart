# Dependencies and build output
node_modules/
ui-panel/client/build/

# Python bytecode
__pycache__/
*.py[cod]

# Logs and editor backups
*.log
*.bak
.DS_Store

# Panel access key, generated by ui-panel/start-prod.sh
ui-panel/config/auth.json

# Runtime state written by the panel (mounted into the container by start-prod.sh)
ui-panel/logs/*
ui-panel/tmp/*
ui-panel/deployments/*
ui-panel/managed_clusters_info/*
!ui-panel/logs/.gitkeep
!ui-panel/tmp/.gitkeep
!ui-panel/deployments/.gitkeep
!ui-panel/managed_clusters_info/.gitkeep

# Per-user Claude Code settings
.claude/settings.local.json
